PROJECT_NAME=BuildResume API

ENVIRONMENT=development

API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/buildresume

SECRET_KEY=replace_with_a_long_random_secret_key_at_least_32_characters

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=60

BACKEND_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500